<div class="azda-body">
    <p class="hint">Art that new actors get instead of the Star Wars placeholders. Leave the token empty to use the portrait. Only placeholder art is replaced; art someone picked is kept.</p>
    {{#each types as |entry|}}
    <fieldset class="azda-type">
        <legend>{{entry.label}}</legend>
        <div class="azda-row">
            <div class="azda-preview" data-preview="{{entry.type}}">
                <img src="{{entry.preview.art}}" alt="{{entry.label}} portrait" data-tooltip="Portrait">
                <img src="{{entry.preview.token}}" alt="{{entry.label}} token" data-tooltip="Token">
            </div>
            <div class="azda-fields">
                <div class="form-group">
                    <label>Portrait</label>
                    <div class="form-fields"><file-picker name="{{entry.type}}.art" type="image" value="{{entry.art}}"></file-picker></div>
                </div>
                <div class="form-group">
                    <label>Token</label>
                    <div class="form-fields"><file-picker name="{{entry.type}}.token" type="image" value="{{entry.token}}" placeholder="Same as portrait"></file-picker></div>
                </div>
            </div>
            <button type="button" class="icon fa-solid fa-arrow-rotate-left" data-action="resetType" data-type="{{entry.type}}" data-tooltip="Reset to the addon's art" aria-label="Reset {{entry.label}} art"></button>
        </div>
    </fieldset>
    {{/each}}
</div>
