<div class="azfog-brush">
    {{#if showSize}}
    <div class="azfog-brush-row">
        <label>Brush size</label>
        <div class="flexrow">
            <input type="range" name="brushSize" value="{{brushSize}}" min="10" max="500" step="10">
            <span class="range-value">{{brushSize}}px</span>
        </div>
    </div>
    {{/if}}
    <div class="azfog-brush-row">
        <label>Opacity <span class="hint">(0% reveals, 100% hides)</span></label>
        <div class="flexrow">
            <input type="range" name="brushOpacity" value="{{brushOpacity}}" min="0" max="100" step="5">
            <span class="range-value">{{brushOpacity}}%</span>
        </div>
        <div class="flexrow azfog-presets">
            <button type="button" data-action="opacityPreset" data-value="0"><i class="fa-solid fa-eye"></i> Reveal</button>
            <button type="button" data-action="opacityPreset" data-value="100"><i class="fa-solid fa-eye-slash"></i> Hide</button>
        </div>
    </div>
</div>
