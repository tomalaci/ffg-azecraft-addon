<div class="azd-campaign-body">
{{#if (eq state "ready")}}
    <div class="azd-campaign-scroll">
        {{#if hasFame}}
        <section class="azd-campaign-fame">
            <div>
                <span class="azd-section-label">{{fameLabel}}</span>
                <span class="azd-campaign-total">{{fame}}</span>
            </div>
            {{#if isGM}}
            <div class="azd-campaign-adjust">
                <button type="button" data-action="adjust" data-delta="-1" aria-label="Decrease Fame">−1</button>
                <button type="button" data-action="adjust" data-delta="1" aria-label="Increase Fame">+1</button>
            </div>
            {{/if}}
        </section>
        {{/if}}

        <section>
            <h3 class="azd-campaign-heading">{{entriesLabel}}</h3>
            {{#if entries.length}}
            <ul class="azd-campaign-factions">
                {{#each entries as |entry|}}
                <li class="{{#if entry.archived}}azd-archived{{/if}}">
                    <span class="azd-faction-name">{{entry.name}}{{#if entry.archived}} <span class="azd-muted">(archived)</span>{{/if}}</span>
                    <span class="azd-campaign-total {{#if (gt entry.total 0)}}azd-positive{{else if (lt entry.total 0)}}azd-negative{{/if}}">{{entry.totalLabel}}</span>
                    {{#if @root.isGM}}
                    <span class="azd-campaign-adjust">
                        {{#unless entry.archived}}
                        <button type="button" data-action="adjust" data-entry-id="{{entry.id}}" data-delta="-1" aria-label="Decrease {{entry.name}}" data-tooltip="Subtract (you can change the amount)">−</button>
                        <button type="button" data-action="adjust" data-entry-id="{{entry.id}}" data-delta="1" aria-label="Increase {{entry.name}}" data-tooltip="Add (you can change the amount)">+</button>
                        {{/unless}}
                        {{#unless entry.unknown}}
                        <button type="button" class="icon fa-solid fa-pen" data-action="renameEntry" data-entry-id="{{entry.id}}" data-name="{{entry.name}}" data-tooltip="Rename" aria-label="Rename"></button>
                        <button type="button" class="icon fa-solid {{#if entry.archived}}fa-box-open{{else}}fa-box-archive{{/if}}" data-action="archiveEntry" data-entry-id="{{entry.id}}" data-archived="{{entry.archived}}" data-tooltip="{{#if entry.archived}}Restore{{else}}Archive (keeps history){{/if}}" aria-label="Archive"></button>
                        {{/unless}}
                    </span>
                    {{/if}}
                </li>
                {{/each}}
            </ul>
            {{else}}
            <p class="azd-muted">Nothing tracked yet.</p>
            {{/if}}
            <div class="azd-campaign-buttons">
                {{#if isGM}}<button type="button" data-action="addEntry"><i class="fa-solid fa-plus" inert></i> Add {{entryNoun}}</button>{{/if}}
                {{#if archivedCount}}<button type="button" data-action="toggleArchived">{{#if showArchived}}Hide{{else}}Show{{/if}} archived ({{archivedCount}})</button>{{/if}}
            </div>
        </section>

        <section>
            <h3 class="azd-campaign-heading">History <span class="azd-muted">({{historyCount}})</span></h3>
            {{#if history.length}}
            <ol class="azd-campaign-history">
                {{#each history as |event|}}
                <li class="{{#if event.corrected}}azd-corrected{{/if}}">
                    <span class="azd-delta {{#if event.positive}}azd-positive{{else}}azd-negative{{/if}}">{{event.deltaLabel}}</span>
                    <div class="azd-history-text">
                        <div><strong>{{event.targetLabel}}</strong>: {{event.reason}}</div>
                        <div class="azd-muted">
                            {{event.authorName}} · {{event.date}}{{#if event.sessionLabel}} · {{event.sessionLabel}}{{/if}}
                            {{#if event.correctsEventId}} · correction{{/if}}
                            {{#if event.corrected}} · corrected{{/if}}
                        </div>
                    </div>
                    {{#if event.canCorrect}}
                    <button type="button" class="icon fa-solid fa-rotate-left" data-action="correct" data-event-id="{{event.eventId}}" data-tooltip="Record a correction" aria-label="Correct"></button>
                    {{/if}}
                </li>
                {{/each}}
            </ol>
            {{#if historyTruncated}}<button type="button" data-action="toggleHistory">Show all</button>{{else if showAllHistory}}<button type="button" data-action="toggleHistory">Show recent</button>{{/if}}
            {{else}}
            <p class="azd-muted">No adjustments recorded.</p>
            {{/if}}
        </section>
    </div>
    <footer class="azd-campaign-footer azd-muted">
        Journal: {{ledgerName}}{{#if isGM}} · <button type="button" class="azd-link" data-action="openJournal">open</button>{{/if}}
    </footer>
{{else}}
    {{#if isGM}}
        {{#if (eq state "missing")}}<p>The configured {{title}} Journal no longer exists.</p>{{/if}}
        {{#if (eq state "restricted")}}<p>The {{title}} Journal is not readable.</p>{{/if}}
        {{#if (eq state "unconfigured")}}<p>No {{title}} tracker yet. It is a Journal in “Mission Dashboard › Trackers” that stores every change, shared by all GMs and Scenes.</p>{{/if}}
        <div class="azd-campaign-buttons">
            <button type="button" data-action="createTracker"><i class="fa-solid fa-book-medical" inert></i> Create {{title}} tracker</button>
        </div>
        {{#if candidates.length}}
        <p>Or use an existing one:</p>
        <ul>
            {{#each candidates as |c|}}<li><button type="button" class="azd-link" data-action="selectTracker" data-uuid="{{c.uuid}}">{{c.name}}</button></li>{{/each}}
        </ul>
        {{/if}}
    {{else}}
        <p class="azd-muted">{{title}} is not available.</p>
    {{/if}}
{{/if}}
</div>
