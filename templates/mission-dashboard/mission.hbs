<section class="azd-panel azd-mission azd-surface" aria-label="Current mission">
    <div class="azd-objective">
        <div class="azd-panel-head azd-panel-head--objective">
            <span class="azd-section-label"><i class="fa-solid fa-crosshairs" inert></i> Current mission</span>
            {{> "azd-panel-tools" panel=mission.objective key="objective" label="Current mission"}}
        </div>
        {{> "azd-ledger-bar" panel=mission.objective key="objective" label="Current mission"}}
        <div class="azd-objective-collapsed">{{mission.objectiveText}}</div>
        <div class="azd-panel-body azd-objective-body azd-journal-content">
            {{~> "azd-page-state" panel=mission.objective}}
        </div>
    </div>
</section>
