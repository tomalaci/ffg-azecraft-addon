<div class="azd-dividers">
    <div class="azd-ledger-controls">
        <div class="azd-size azd-ledger-size" role="group" aria-label="Mission panel size (your screen only)">
            <button type="button" data-action="stepLedger" data-step="-1" data-tooltip="Smaller panels (the smallest is one bar)" aria-label="Smaller mission panels"><i class="fa-solid fa-caret-down" inert></i></button>
            <span class="azd-size-pips" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <button type="button" data-action="stepLedger" data-step="1" data-tooltip="Larger panels" aria-label="Larger mission panels"><i class="fa-solid fa-caret-up" inert></i></button>
        </div>
        <div class="azd-size azd-font-size" role="group" aria-label="Mission panel text size (your screen only)">
            <button type="button" data-action="stepFont" data-step="-1" data-tooltip="Smaller text in the mission panels" aria-label="Smaller text"><span class="azd-font-a azd-font-a--small">A</span></button>
            <span class="azd-size-pips" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            <button type="button" data-action="stepFont" data-step="1" data-tooltip="Larger text in the mission panels" aria-label="Larger text"><span class="azd-font-a">A</span></button>
        </div>
    </div>
    <div class="azd-divider" data-divider="0" role="separator" aria-orientation="vertical" aria-label="Resize current mission and key intel" data-tooltip="Drag to resize · double-click to reset"></div>
</div>
