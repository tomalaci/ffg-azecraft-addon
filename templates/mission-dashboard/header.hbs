<header class="azd-header azd-surface">
    <div class="azd-header-title">
        <span class="azd-kicker azd-squad">
            <i class="fa-solid fa-people-group" inert></i>
            {{#if (and isGM (gt squads.length 1))}}
            <select data-squad-select aria-label="Active squad (changes it for everyone)" data-tooltip="Active squad: changes it for everyone">
                {{#each squads as |s|}}<option value="{{s.id}}" {{#if s.active}}selected{{/if}}>{{s.name}}</option>{{/each}}
            </select>
            {{else}}
            <span>{{#if squad}}{{squad.name}}{{else}}Mission{{/if}}</span>
            {{/if}}
        </span>
        <span class="azd-title" data-tooltip="{{title}}">{{#if title}}{{title}}{{else}}{{sceneName}}{{/if}}</span>
    </div>
    <div class="azd-header-controls">
        {{#if standing.reputation.ready}}
        <button type="button" class="azd-chip" data-action="openTracker" data-kind="reputation" data-tooltip="Reputation: Fame {{standing.reputation.value}} and faction standing" aria-label="Reputation: Fame {{standing.reputation.value}}">
            <i class="fa-solid fa-ranking-star" inert></i><span class="azd-chip-label"> Fame {{standing.reputation.value}}</span>
        </button>
        {{else if isGM}}
        <button type="button" class="azd-icon-button" data-action="openTracker" data-kind="reputation" data-tooltip="Reputation (not set up yet)" aria-label="Reputation">
            <i class="fa-solid fa-ranking-star" inert></i>
        </button>
        {{/if}}
        {{#if standing.resources.ready}}
        <button type="button" class="azd-chip" data-action="openTracker" data-kind="resources" data-tooltip="Resources: {{standing.resources.value}} cr and materials" aria-label="Resources: {{standing.resources.value}} credits">
            <i class="fa-solid fa-coins" inert></i><span class="azd-chip-label"> {{standing.resources.value}} cr</span>
        </button>
        {{else if isGM}}
        <button type="button" class="azd-icon-button" data-action="openTracker" data-kind="resources" data-tooltip="Resources (not set up yet)" aria-label="Resources">
            <i class="fa-solid fa-coins" inert></i>
        </button>
        {{/if}}
        <button type="button" class="azd-icon-button" data-action="cycleCompact" data-tooltip="Compact cards: {{compactLabel}}" aria-label="Compact cards: {{compactLabel}}">
            <i class="fa-solid fa-table-list" inert></i>
        </button>
        <button type="button" class="azd-icon-button" data-action="toggleMission" data-tooltip="{{#if prefs.missionCollapsed}}Expand{{else}}Collapse{{/if}} mission panels" aria-label="Toggle mission panels" aria-pressed="{{prefs.missionCollapsed}}">
            <i class="fa-solid {{#if prefs.missionCollapsed}}fa-chevron-up{{else}}fa-chevron-down{{/if}}" inert></i>
        </button>
        <button type="button" class="azd-icon-button" data-action="fitScene" data-tooltip="Fit the Scene into the frame (your view only)" aria-label="Fit the Scene into the frame">
            <i class="fa-solid fa-crop-simple" inert></i>
        </button>
        <button type="button" class="azd-icon-button" data-action="openHelp" data-tooltip="Help and quick start" aria-label="Mission dashboard help">
            <i class="fa-solid fa-circle-question" inert></i>
        </button>
        {{#if isGM}}
        <button type="button" class="azd-icon-button" data-action="configure" data-tooltip="Configure mission dashboard (GM)" aria-label="Configure mission dashboard">
            <i class="fa-solid fa-gear" inert></i>
        </button>
        {{/if}}
    </div>
    {{#if squadEffects.show}}
    {{#*inline "squadChip"}}
    {{#if c.condition}}
    <span class="azd-squad-effect azd-squad-condition {{#unless c.on}}azd-squad-condition--off{{/unless}}" data-squad-chip>
        <button type="button" class="azd-squad-condition-toggle" data-action="toggleCondition" data-condition="{{c.id}}" data-tooltip="{{c.tooltip}}. Click to switch it {{#if c.on}}off{{else}}on{{/if}}." aria-pressed="{{c.on}}" aria-label="{{c.name}}: switch {{#if c.on}}off{{else}}on{{/if}}">
            <i class="fa-solid {{#if c.on}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" inert></i><img src="{{c.img}}" alt=""> {{c.name}}{{#if c.on}} <span class="azd-muted">{{c.count}}/{{members}}</span>{{/if}}
        </button>
        <button type="button" data-action="removeCondition" data-condition="{{c.id}}" data-tooltip="Remove the condition" aria-label="Remove {{c.name}}"><i class="fa-solid fa-xmark" inert></i></button>
    </span>
    {{else}}
    <span class="azd-squad-effect" data-squad-chip data-tooltip="{{c.tooltip}} ({{c.count}} of {{members}})">
        <img src="{{c.img}}" alt=""> {{c.name}} <span class="azd-muted">{{c.count}}/{{members}}</span>
        <button type="button" data-action="removeSquadEffect" data-group="{{c.group}}" aria-label="Remove {{c.name}} from the squad"><i class="fa-solid fa-xmark" inert></i></button>
    </span>
    {{/if}}
    {{/inline}}
    <div class="azd-squad-effects">
        <div class="azd-squad-effects-bar">
            <span class="azd-squad-effects-label"><i class="fa-solid fa-wand-sparkles" inert></i> Squad effects</span>
            {{#if squadEffects.canCondition}}
            <button type="button" class="azd-squad-add" data-action="addCondition" data-tooltip="Squad condition: stays on every member (and anyone who joins) until you switch it off, e.g. a hazardous environment" aria-label="Add squad condition"><i class="fa-solid fa-smog" inert></i> Condition</button>
            {{/if}}
            <button type="button" class="azd-squad-add" data-action="addSquadEffect" data-tooltip="One-off: give an effect to the whole squad or chosen members now (e.g. Boost on the next check); each member keeps their own copy" aria-label="Add effect to squad members"><i class="fa-solid fa-plus" inert></i> Effect</button>
        </div>
        {{#if squadEffects.chips.length}}
        <div class="azd-squad-effects-chips" data-squad-chips>
            {{#each squadEffects.chips as |c|}}{{> squadChip c=c members=@root.squadEffects.members}}{{/each}}
            <span class="azd-squad-more" data-squad-more hidden>
                <button type="button" class="azd-squad-more-button" data-action="toggleSquadMore" aria-haspopup="true" aria-expanded="false"><span data-squad-more-label></span> <i class="fa-solid fa-caret-down" inert></i></button>
                <div data-squad-more-menu hidden>
                    {{#each squadEffects.chips as |c|}}{{> squadChip c=c members=@root.squadEffects.members}}{{/each}}
                </div>
            </span>
        </div>
        {{/if}}
    </div>
    {{/if}}
</header>
