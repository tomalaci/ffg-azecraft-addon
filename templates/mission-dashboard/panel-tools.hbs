<span class="azd-panel-tools">
    {{#if panel.isGM}}
    <button type="button" class="azd-icon-button" data-action="newLedger" data-panel="{{key}}" data-tooltip="New {{label}} ledger" aria-label="New {{label}} ledger"><i class="fa-solid fa-book-medical" inert></i></button>
    <button type="button" class="azd-icon-button" data-action="newEntry" data-panel="{{key}}" data-tooltip="New entry in this ledger (becomes the newest)" aria-label="New {{label}} entry"><i class="fa-solid fa-plus" inert></i></button>
    {{/if}}
    {{#if panel.canEdit}}
    <button type="button" class="azd-icon-button" data-action="editPage" data-page-uuid="{{panel.uuid}}" data-tooltip="Edit this entry" aria-label="Edit {{label}} entry"><i class="fa-solid fa-pen-to-square" inert></i></button>
    {{/if}}
</span>
