<div class="azd-config-root">
<div class="azd-config-body standard-form">
    {{#if errors.length}}
    <div class="azd-config-errors">
        {{#each errors}}<p><i class="fa-solid fa-circle-exclamation" inert></i> {{this}}</p>{{/each}}
    </div>
    {{/if}}
    {{#if warnings.length}}
    <div class="azd-config-warnings">
        {{#each warnings}}<p><i class="fa-solid fa-triangle-exclamation" inert></i> {{this}}</p>{{/each}}
    </div>
    {{/if}}

    <fieldset>
        <legend>Scene: {{scene.name}}</legend>
        <div class="form-group">
            <label for="azd-shown-{{scene.id}}">Show dashboard on this Scene</label>
            <div class="form-fields">
                <input type="checkbox" id="azd-shown-{{scene.id}}" name="shown" {{checked shown}}>
            </div>
            <p class="hint">{{#if showOnAllScenes}}The dashboard shows on every Scene (module setting). Untick to hide it on this Scene only, e.g. a title screen.{{else}}“Show on every Scene” is off in the module settings, so the dashboard only shows on Scenes where this is ticked.{{/if}} Players can always minimize it on their own screen.</p>
        </div>
        <div class="form-group">
            <label for="azd-fit-{{scene.id}}">Fit into the frame when opened</label>
            <div class="form-fields">
                <input type="checkbox" id="azd-fit-{{scene.id}}" name="fitOnOpen" {{checked fitOnOpen}}>
            </div>
            <p class="hint">For art and landing Scenes: when someone opens this Scene, their view zooms so the whole Scene image sits inside the dashboard frame. Anyone can also use <i class="fa-solid fa-crop-simple" inert></i> in the dashboard header at any time.</p>
        </div>
        <div class="form-group stacked">
            <label>Squad and mission</label>
            <div class="azd-config-source">
                <label><input type="radio" name="source" value="campaign" {{checked isCampaign}}> Campaign dashboard <span class="hint">(shared by all {{campaignSceneCount}} Scenes that use it)</span></label>
                <label><input type="radio" name="source" value="scene" {{checked (not isCampaign)}}> This Scene's own squad and mission <span class="hint">(e.g. a one-off mission)</span></label>
            </div>
        </div>
    </fieldset>

    {{#if isCampaign}}
    <p class="azd-config-banner"><i class="fa-solid fa-globe" inert></i> You are editing the <strong>campaign dashboard</strong>. Changes apply to every Scene that uses it.</p>
    {{else}}
    <p class="azd-config-banner azd-config-banner--scene"><i class="fa-solid fa-map" inert></i> You are editing <strong>{{scene.name}}</strong>'s own dashboard. Other Scenes are not affected.
        <button type="button" class="azd-config-inline" data-action="copyToCampaign" data-tooltip="Replace the campaign dashboard with this setup and switch this Scene to it">Use as campaign dashboard</button></p>
    {{/if}}

    <fieldset>
        <legend>Squad</legend>
        <ol class="azd-config-rows">
            {{#each slots as |slot|}}
            <li class="azd-config-row">
                <span class="azd-config-index">{{slot.number}}</span>
                <select name="party.{{slot.index}}.actorUuid" aria-label="Slot {{slot.number}} actor">
                    <option value="">— Empty —</option>
                    {{#if slot.missing}}<option value="{{slot.actorUuid}}" selected>Missing Actor ({{slot.actorUuid}})</option>{{/if}}
                    {{#each @root.partyGroups as |group|}}
                    <optgroup label="{{group.label}}">
                        {{#each group.actors as |actor|}}
                        <option value="{{actor.uuid}}" {{#if (eq actor.uuid slot.actorUuid)}}selected{{/if}}>{{actor.name}}</option>
                        {{/each}}
                    </optgroup>
                    {{/each}}
                </select>
                <button type="button" class="icon fa-solid fa-arrow-up" data-action="moveSlot" data-index="{{slot.index}}" data-direction="-1" {{disabled slot.first}} data-tooltip="Move up" aria-label="Move up"></button>
                <button type="button" class="icon fa-solid fa-arrow-down" data-action="moveSlot" data-index="{{slot.index}}" data-direction="1" {{disabled slot.last}} data-tooltip="Move down" aria-label="Move down"></button>
                <button type="button" class="icon fa-solid fa-trash" data-action="removeSlot" data-index="{{slot.index}}" {{disabled (and slot.first slot.last)}} data-tooltip="Remove slot" aria-label="Remove slot"></button>
            </li>
            {{/each}}
        </ol>
        <button type="button" data-action="addSlot" {{disabled (not canAddSlot)}}><i class="fa-solid fa-plus" inert></i> Add slot</button>
        <p class="hint">Slots use world Actors. Linked tokens show the same values; damage on unlinked tokens is not shown.</p>
    </fieldset>

    <fieldset>
        <legend>Mission ledgers</legend>
        <p class="hint">Each tab shows a <strong>ledger</strong>: a Journal whose pages are that tab's entries, newest shown first. Ledgers are kept in the “Mission Dashboard” Journal folder. Everyone can switch between the ledgers they can read, and page through entries, on their own screen; the default below is what everyone sees first.</p>
        {{#each panels as |panel|}}
        <div class="form-group">
            <label>{{panel.label}}</label>
            <div class="form-fields">
                <select name="ledgers.{{panel.key}}" aria-label="Default {{panel.label}} ledger">
                    <option value="">— Most recent ledger —</option>
                    {{#each panel.options as |option|}}
                    <option value="{{option.uuid}}" {{#if (eq option.uuid panel.selected)}}selected{{/if}}>{{option.name}}</option>
                    {{/each}}
                </select>
                <button type="button" class="icon fa-solid fa-book-medical" data-action="newLedger" data-panel="{{panel.key}}" data-tooltip="New ledger" aria-label="New {{panel.label}} ledger"></button>
                <button type="button" class="icon fa-solid fa-book-open" data-action="openLedger" data-panel="{{panel.key}}" data-tooltip="Open ledger Journal" aria-label="Open {{panel.label}} ledger" {{disabled (not panel.shownName)}}></button>
            </div>
            {{#if panel.missing}}<p class="hint azd-config-bad">The default ledger no longer exists; the most recent ledger is shown instead.</p>{{/if}}
            {{#if panel.shownName}}<p class="hint">Shows “{{panel.shownName}}”{{#if panel.playerAccess}} · {{panel.playerAccess}}{{/if}}</p>{{else}}<p class="hint">No ledger yet.</p>{{/if}}
        </div>
        {{/each}}
    </fieldset>

    <fieldset>
        <legend>People of Note</legend>
        <p class="hint">Shown in Key Intel. Name and portrait come from the Actor; players only see people whose Actor they can see (Limited or higher). Everything written here is visible to players.</p>
        <ol class="azd-config-people">
            {{#each people as |person|}}
            <li class="azd-config-person">
                <div class="azd-config-row">
                    <select name="people.{{person.index}}.actorUuid" aria-label="Person actor">
                        <option value="">— Choose Actor —</option>
                        {{#if person.missing}}<option value="{{person.actorUuid}}" selected>Missing Actor ({{person.actorUuid}})</option>{{/if}}
                        {{#each @root.peopleGroups as |group|}}
                        <optgroup label="{{group.label}}">
                            {{#each group.actors as |actor|}}
                            <option value="{{actor.uuid}}" {{#if (eq actor.uuid person.actorUuid)}}selected{{/if}}>{{actor.name}}</option>
                            {{/each}}
                        </optgroup>
                        {{/each}}
                    </select>
                    <button type="button" class="icon fa-solid fa-arrow-up" data-action="movePerson" data-index="{{person.index}}" data-direction="-1" {{disabled person.first}} aria-label="Move up"></button>
                    <button type="button" class="icon fa-solid fa-arrow-down" data-action="movePerson" data-index="{{person.index}}" data-direction="1" {{disabled person.last}} aria-label="Move down"></button>
                    <button type="button" class="icon fa-solid fa-trash" data-action="removePerson" data-index="{{person.index}}" aria-label="Remove person"></button>
                </div>
                {{#if person.hiddenFromPlayers}}<p class="hint azd-config-bad"><i class="fa-solid fa-eye-slash" inert></i> No player can see this Actor yet, so players won't see this entry.</p>{{/if}}
                <div class="azd-config-person-fields">
                    <input type="text" name="people.{{person.index}}.role" value="{{person.role}}" maxlength="{{@root.textMax}}" placeholder="Role (e.g. ExoGeni researcher)">
                    <input type="text" name="people.{{person.index}}.status" value="{{person.status}}" maxlength="{{@root.textMax}}" placeholder="Status (e.g. Missing)">
                    <input type="text" name="people.{{person.index}}.relationship" value="{{person.relationship}}" maxlength="{{@root.textMax}}" placeholder="Relationship (e.g. Cooperative)">
                    <textarea name="people.{{person.index}}.note" maxlength="{{@root.noteMax}}" rows="2" placeholder="Note (player-visible)">{{person.note}}</textarea>
                </div>
            </li>
            {{/each}}
        </ol>
        <button type="button" data-action="addPerson"><i class="fa-solid fa-user-plus" inert></i> Add person</button>
    </fieldset>
</div>
<footer class="form-footer">
    <button type="button" class="azd-config-help" data-action="openHelp" data-tooltip="Help and GM quick start" aria-label="Help"><i class="fa-solid fa-circle-question" inert></i></button>
    <button type="button" data-action="reload" data-tooltip="Discard edits and load the saved configuration"><i class="fa-solid fa-rotate" inert></i> Reload</button>
    <button type="button" data-action="cancel"><i class="fa-solid fa-xmark" inert></i> Cancel</button>
    <button type="submit"><i class="fa-solid fa-floppy-disk" inert></i> Save</button>
</footer>
</div>
