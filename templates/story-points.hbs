<div class="azsp-panel" aria-label="Story points">
    <div class="azsp-head">
        <span class="azsp-title"><i class="fa-solid fa-scale-balanced" inert></i> Story points</span>
    </div>

    <div class="azsp-row">
        <button type="button" class="azsp-side azsp-side--squad" data-action="use" data-side="squad" {{disabled (not canUseSquad)}}
            data-tooltip="Use a {{label.squad}} point for a story advantage (it passes to {{label.threat}})" aria-label="Use a {{label.squad}} story point">
            <span class="azsp-count">{{pool.squad}}</span>
            <span class="azsp-name">{{label.squad}}</span>
        </button>

        <div class="azsp-bar" role="img" aria-label="{{label.squad}} {{pool.squad}}, {{label.threat}} {{pool.threat}}" style="--azsp-share: {{squadPercent}}%">
            {{#if empty}}
            <span class="azsp-bar-empty">No story points</span>
            {{else}}
            {{#each segments as |segment|}}<span class="azsp-seg azsp-seg--{{segment.side}}{{#if segment.edge}} azsp-seg--edge{{/if}}"></span>{{/each}}
            {{/if}}
        </div>

        <button type="button" class="azsp-side azsp-side--threat" data-action="use" data-side="threat" {{disabled (not canUseThreat)}}
            data-tooltip="{{#if isGM}}Use a {{label.threat}} point for a story setback (it passes to {{label.squad}}){{else}}{{label.threat}}: the GM's story points{{/if}}" aria-label="{{label.threat}} story points">
            <span class="azsp-count">{{pool.threat}}</span>
            <span class="azsp-name">{{label.threat}}</span>
        </button>
    </div>

    {{#if isGM}}
    <div class="azsp-gm">
        <button type="button" class="azsp-icon azsp-take azsp-take--squad" data-action="adjust" data-side="squad" data-delta="1" {{disabled (not pool.threat)}} data-tooltip="Move a point from {{label.threat}} to {{label.squad}}" aria-label="Move a point from {{label.threat}} to {{label.squad}}"><i class="fa-solid fa-plus" inert></i></button>
        <span class="azsp-capacity">
            <button type="button" class="azsp-icon" data-action="resize" data-delta="-1" {{disabled empty}} data-tooltip="Remove a story point from play (from the side with more)" aria-label="Decrease story point capacity">−</button>
            <span class="azsp-capacity-value" data-tooltip="Story points in play">{{capacity}}</span>
            <button type="button" class="azsp-icon" data-action="resize" data-delta="1" data-tooltip="Add a story point to play (to the side with fewer)" aria-label="Increase story point capacity">+</button>
        </span>
        <button type="button" class="azsp-icon azsp-take azsp-take--threat" data-action="adjust" data-side="threat" data-delta="1" {{disabled (not pool.squad)}} data-tooltip="Move a point from {{label.squad}} to {{label.threat}}" aria-label="Move a point from {{label.squad}} to {{label.threat}}"><i class="fa-solid fa-plus" inert></i></button>
    </div>
    {{/if}}
</div>
