#!/usr/bin/env sh
# Fast, side-effect-free validation: no book material in git, lint, JS syntax, manifest JSON, unit tests.
set -eu
cd "$(dirname "$0")/.."
# Book material (copyrighted, kept in the git-ignored .book_db/ and .memory/) must never be in git:
# the module is public and releases are built from the repository.
if [ -n "$(git ls-files -- .book_db .memory '*.pdf')" ]; then
    echo "Book material is tracked by git (.book_db/, .memory/ or a PDF); remove it with 'git rm --cached'." >&2
    exit 1
fi
if [ ! -x node_modules/.bin/eslint ]; then
    echo "ESLint is not installed; run 'npm ci' once in this repository." >&2
    exit 1
fi
node_modules/.bin/eslint .
for f in main.js scripts/*.js scripts/*/*.js; do node --check "$f"; done
node -e 'JSON.parse(require("fs").readFileSync("module.json", "utf8"))'
node --test --test-reporter=dot "tests/*.test.js"
echo "ok"
